{
  "html": "<div style=\"background:linear-gradient(105deg,#3d1881,#270e48);padding:56px 24px;text-align:center;font-family:'DM Sans',system-ui,sans-serif;border-radius:16px\"><h2 style=\"color:#fff;font-family:'DM Sans',system-ui,sans-serif;font-size:2rem;font-weight:700;letter-spacing:-0.02em;margin:0 0 12px;line-height:1.1\">{{title}}</h2><p style=\"color:rgba(245,240,232,0.82);font-size:1.05rem;margin:0 auto 24px;max-width:48ch;line-height:1.5\">{{description}}</p><a href=\"{{href}}\" style=\"display:inline-block;background:#fff;color:#141417;font-family:'DM Sans',system-ui,sans-serif;font-size:1rem;font-weight:700;padding:14px 30px;border-radius:8px;text-decoration:none\">{{buttonText}}</a></div>",
  "slots": [
    "title",
    "description",
    "buttonText"
  ],
  "fallback": {
